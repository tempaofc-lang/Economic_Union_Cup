# ---------------------------------------------------------------------------
# 复制本文件为 .env，然后填入真实值（本包已自动复制好 .env，直接改 key 即可）：
#     copy .env.example .env
# .env 已在 .gitignore 中，不会被提交。绝对不要把真实 Key 写进这个示例文件！
# ---------------------------------------------------------------------------

# DeepSeek API Key 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-请替换为你的真实key

# 模型名：deepseek-chat（官方标准名，快且便宜）/ deepseek-reasoner（更强更贵）
# ⚠️ 不要填 deepseek-flash 或 deepseek-v4-pro：官方没有这两个模型，会报 Model Not Exist。
#    agent.py 里的默认值正是 deepseek-flash，所以这一行必须显式写成 deepseek-chat。
DEEPSEEK_MODEL=deepseek-chat

# 接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 置 0 后完全不调用大模型，只用本地规则引擎（断网演示 / 答辩保命用）
USE_REAL_LLM_API=1

# 单次请求超时秒数
LLM_TIMEOUT=25
