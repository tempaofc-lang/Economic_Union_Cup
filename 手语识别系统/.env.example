# ---------------------------------------------------------------------------
# 复制本文件为 .env，然后填入真实值：
#     copy .env.example .env
# .env 已在 .gitignore 中，不会被提交。绝对不要把真实 Key 写进这个示例文件！
# ---------------------------------------------------------------------------

# DeepSeek API Key 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-请替换为你的真实key

# 模型名：deepseek-flash（默认，快且便宜）/ deepseek-v4-pro（更强更贵）
DEEPSEEK_MODEL=deepseek-flash

# 置 0 后完全不调用大模型，只用本地规则引擎（断网演示 / 答辩保命用）
USE_REAL_LLM_API=1

# 单次请求超时秒数
LLM_TIMEOUT=25
